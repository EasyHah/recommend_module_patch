# Appflow Chat 环境变量示例（复制为 .env.local 并根据实际情况修改）
# 必填：你的 Appflow 集成 ID（示例以 cit- 开头）
VITE_APPFLOW_INTEGRATE_ID=cit-44fd57644e264fecabe0

# 必填：Appflow 对外服务域名（不要带末尾 /）
# 如控制台给到的是 1677039950952251.appflow.aliyunnest.com，可写成完整 https://1677039950952251.appflow.aliyunnest.com
VITE_APPFLOW_REQUEST_DOMAIN=https://1677039950952251.appflow.aliyunnest.com

# 推荐：来源域名（当前站点访问来源，用于 trial 或白名单校验），一般为你本地/线上站点 origin
# 本地开发（Vite 默认端口 5173）： http://localhost:5173 或 http://127.0.0.1:5173
# 线上请填写你的正式域名 origin，例如 https://yourdomain.com
VITE_APPFLOW_SOURCE_DOMAIN=http://localhost:5173

# 可选：降级方案 - 直接嵌入的 iframe 页面地址（例如你提供的 webhook 页面）
# 说明：当 SDK 初始化或发送消息发生 400（未绑定域名/配置不匹配）时，会自动回退到 iframe 窗口以保证可用
# 例如：
# VITE_APPFLOW_EMBED_IFRAME_URL=https://1677039950952251.appflow.aliyunnest.com/webhook/home/b271bff17f8c212b5dc99f0d9a8b39e274a132e058defe12439ec138427197ee9c930bca471b8865f4/index
VITE_APPFLOW_EMBED_IFRAME_URL=https://1677039950952251.appflow.aliyunnest.com/webhook/home/b271bff17f8c212b5dc99f0d9a8b39e274a132e058defe12439ec138427197ee9c930bca471b8865f4/index

# ================= Additional Service Keys (placeholders only, DO NOT COMMIT REAL VALUES) =================
# 高德 Web JS API Key
VITE_AMAP_KEY=YOUR_AMAP_BROWSER_KEY
# 高德安全码（如果使用）
VITE_AMAP_SECURITY=YOUR_AMAP_SECURITY_CODE
# 高德 REST Key
VITE_AMAP_REST_KEY=YOUR_AMAP_REST_KEY

# 和风天气 API Key
VITE_QWEATHER_KEY=YOUR_QWEATHER_KEY

# Tencent Cloud LKE Frontend
VITE_LKE_ACCESS_TYPE=ws
VITE_LKE_APP_KEY=YOUR_LKE_APP_KEY
VITE_LKE_BOT_ID=YOUR_LKE_BOT_ID
VITE_LKE_TOKEN_ENDPOINT=http://localhost:3000/getDemoToken
VITE_LKE_API_BASE=https://lke.cloud.tencent.com/cgi/capi
VITE_LKE_WS_BASE=wss://wss.lke.cloud.tencent.com
VITE_LKE_SSE_BASE=https://wss.lke.cloud.tencent.com

# Server runtime credentials (DO NOT EXPOSE TO FRONTEND)
SECRET_ID=YOUR_TENCENT_CLOUD_SECRET_ID
SECRET_KEY=YOUR_TENCENT_CLOUD_SECRET_KEY
SERVER_PORT=3000
