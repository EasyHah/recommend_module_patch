# Appflow Chat 环境变量示例（复制为 .env.local 并根据实际情况修改）
# 必填：你的 Appflow 集成 ID（示例以 cit- 开头）
VITE_APPFLOW_INTEGRATE_ID=cit-44fd57644e264fecabe0

# 必填：Appflow 对外服务域名（不要带末尾 /）
# 如控制台给到的是 1677039950952251.appflow.aliyunnest.com，可写成完整 https://1677039950952251.appflow.aliyunnest.com
VITE_APPFLOW_REQUEST_DOMAIN=https://1677039950952251.appflow.aliyunnest.com

# 推荐：来源域名（当前站点访问来源，用于 trial 或白名单校验），一般为你本地/线上站点 origin
# 本地开发（Vite 默认端口 5173）： http://localhost:5173 或 http://127.0.0.1:5173
# 线上请填写你的正式域名 origin，例如 https://yourdomain.com
VITE_APPFLOW_SOURCE_DOMAIN=http://localhost:5173

# 可选：降级方案 - 直接嵌入的 iframe 页面地址（例如你提供的 webhook 页面）
# 说明：当 SDK 初始化或发送消息发生 400（未绑定域名/配置不匹配）时，会自动回退到 iframe 窗口以保证可用
# 例如：
# VITE_APPFLOW_EMBED_IFRAME_URL=https://1677039950952251.appflow.aliyunnest.com/webhook/home/b271bff17f8c212b5dc99f0d9a8b39e274a132e058defe12439ec138427197ee9c930bca471b8865f4/index
VITE_APPFLOW_EMBED_IFRAME_URL=https://1677039950952251.appflow.aliyunnest.com/webhook/home/b271bff17f8c212b5dc99f0d9a8b39e274a132e058defe12439ec138427197ee9c930bca471b8865f4/index

## ------------------------------------------------------------------
## 下面是当前代码实际“有引用”的环境变量清单（匹配 import.meta.env.*）
## 复制为 .env.local 后填写；不要在仓库中提交真实值。
## ------------------------------------------------------------------

### 1. Appflow Chat（src/composables/useAppflowChat.ts）
# 已在上方填写：
# VITE_APPFLOW_INTEGRATE_ID=
# VITE_APPFLOW_REQUEST_DOMAIN=
# VITE_APPFLOW_SOURCE_DOMAIN=
# VITE_APPFLOW_EMBED_IFRAME_URL=

### 2. LKE Chat （src/composables/useLKEChat.ts）
# 访问类型：ws 或 sse（默认 ws）
VITE_LKE_ACCESS_TYPE=ws
# 控制台发放的应用 App Key（必填，留空等待你填写）
VITE_LKE_APP_KEY=
# 机器人 Bot ID（必填）
VITE_LKE_BOT_ID=
# 获取临时 token 的后端接口（前端开发可用本地 mock）
VITE_LKE_TOKEN_ENDPOINT=/getDemoToken
# API 基础地址（公网默认即可，如需代理可改）
VITE_LKE_API_BASE=https://lke.cloud.tencent.com/cgi/capi
VITE_LKE_WS_BASE=wss://wss.lke.cloud.tencent.com
VITE_LKE_SSE_BASE=https://wss.lke.cloud.tencent.com

### 2b. DeepSeek Chat（园区厂家/供应商推荐）
# 后端私密变量（写到 .env.local，不要提交）
DEEPSEEK_API_KEY=
# 可选：默认 deepseek-chat
DEEPSEEK_MODEL=deepseek-chat
# 可选：默认 https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 前端可选：默认 /api/deepseek/chat
VITE_DEEPSEEK_ENDPOINT=/api/deepseek/chat

### 3. 高德地图 （Route / 地址解析 / 路径规划相关组件 & amapLoader.ts）
# Web Key（必填）
VITE_AMAP_KEY=
# JS 安全密钥 securityJsCode（可选但建议配置，用于正式环境）
VITE_AMAP_SECURITY=

### 4. 和风天气（src/services/weather.ts 等）
# 和风天气 API Key（必填，否则天气接口会抛错）
VITE_QWEATHER_KEY=

### 5. 可选：Cesium Ion（当前代码里暂未直接引用；若后续在 main.ts 或初始化里使用可解注释）
# VITE_CESIUM_ION_TOKEN=YOUR_CESIUM_ION_TOKEN

### 6. 可选：后端统一 API Base（当前代码未引用；如果你在 services 里要拼接可启用）
# VITE_API_BASE=http://localhost:3000

### 7. 可选：功能开关示例（未使用，仅示例）
# VITE_FEATURE_FLAG_X=true

### 8. （历史保留）腾讯云密钥
# 这些不要放到前端暴露；如果需要签名逻辑，请放到后端服务。此前泄露已清理历史。
# VITE_TENCENT_SECRET_ID=YOUR_TENCENT_SECRET_ID
# VITE_TENCENT_SECRET_KEY=YOUR_TENCENT_SECRET_KEY

### 9. （未使用占位）灾害/扩展 API Key
# 目前代码里没有 import.meta.env.VITE_DISASTER_API_KEY 的引用；如果未来添加再启用。
# VITE_DISASTER_API_KEY=YOUR_DISASTER_KEY

## 变量命名差异说明：
# 1) 代码使用 VITE_QWEATHER_KEY 而不是 VITE_WEATHER_API_KEY —— 已按实际代码保留前者，移除后者。
# 2) 新增模板缺失的 VITE_LKE_* / VITE_AMAP_SECURITY / VITE_QWEATHER_KEY。
# 3) 保留未被代码直接使用的示例变量都加了“可选 / 未使用”注释，以免混淆。
# 4) 任何要暴露给前端的变量必须以 VITE_ 前缀；私密后端变量不要放这里。

## 使用步骤（快速指引）：
# cp .env.example .env.local  (或手动新建 .env.local)
# 然后填：VITE_APPFLOW_INTEGRATE_ID / VITE_APPFLOW_REQUEST_DOMAIN / VITE_LKE_APP_KEY / VITE_LKE_BOT_ID / VITE_AMAP_KEY / VITE_QWEATHER_KEY 等。

## 安全提示：
# .env.local 已被 .gitignore 忽略；不要提交它。发生密钥泄露需立即到各平台控制台吊销并替换。
